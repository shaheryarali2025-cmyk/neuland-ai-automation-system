    {
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mondayComApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "API-Version",
              "value": "2026-07"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    query: `\n      mutation (\n        $itemId: ID!\n        $activityId: String!\n        $title: String!\n        $summary: String!\n        $content: String!\n        $timestamp: ISO8601DateTime!\n      ) {\n        create_timeline_item(\n          item_id: $itemId\n          custom_activity_id: $activityId\n          title: $title\n          summary: $summary\n          content: $content\n          timestamp: $timestamp\n        ) {\n          id\n        }\n      }\n    `,\n    variables: {\n      itemId: String($json.monday_item_id),\n\n      activityId: \"15376fb8-826a-4cdb-84f5-a16b3e3bfd16\",\n\n      title: $json.activity_title,\n\n      summary: `${$json.direction} — ${$json.subject}`.slice(0, 255),\n\n      content:\n        `From: ${$json.from_email}<br>` +\n        `To: ${$json.to_email}<br>` +\n        `Subject: ${$json.subject}<br>` +\n        `Source: Instantly<br><br>` +\n        `${$json.content}`,\n\n      timestamp: $json.timestamp\n    }\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,

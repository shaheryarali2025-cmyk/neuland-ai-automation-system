    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const message = $json.message || {};\nconst leadEmail = String($json.lead_email || '').trim().toLowerCase();\nconst fromEmail = String(message.from_address_email || '').trim().toLowerCase();\n\nconst isLeadResponse = fromEmail === leadEmail;\n\nlet activityTitle;\nlet direction;\n\nif (isLeadResponse) {\n  activityTitle = 'Instantly Lead Response';\n  direction = 'Incoming';\n} else if (Number(message.ue_type) === 1) {\n  activityTitle = 'Instantly Campaign Email';\n  direction = 'Outgoing';\n} else {\n  activityTitle = \"Benjamin's Response\";\n  direction = 'Outgoing';\n}\n\n// Received email bodies often include the entire quoted conversation.\n// Remove that quoted section because every message is being logged separately.\nlet contentText = String(\n  message.body?.text ||\n  message.content_preview ||\n  ''\n);\n\ncontentText = contentText\n  .split(/\\nOn .+wrote:\\s*\\n/i)[0]\n  .split(/\\nLe .+a écrit\\s*:\\s*\\n/i)[0]\n  .trim();\n\nlet contentHtml = String(message.body?.html || '');\n\ncontentHtml = contentHtml\n  .split(/<div[^>]*class=[\"'][^\"']*gmail_quote[^\"']*[\"'][^>]*>/i)[0]\n  .split(/<blockquote[^>]*class=[\"'][^\"']*gmail_quote[^\"']*[\"'][^>]*>/i)[0]\n  .trim();\n\nconst finalContent =\n  contentHtml ||\n  contentText ||\n  message.content_preview ||\n  'Email content unavailable';\n\nreturn {\n  json: {\n    monday_item_id: String($json.monday_item_id),\n    lead_email: $json.lead_email,\n    lead_name: $json.lead_name,\n\n    instantly_email_id: message.id || '',\n    message_id: message.message_id || '',\n    thread_id: message.thread_id || '',\n\n    activity_title: activityTitle,\n    direction,\n\n    from_email: message.from_address_email || '',\n    to_email: message.to_address_email_list || '',\n    subject: message.subject || 'Instantly email',\n    content: finalContent,\n\n    timestamp:\n      message.timestamp_email ||\n      message.timestamp_created ||\n      new Date().toISOString(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

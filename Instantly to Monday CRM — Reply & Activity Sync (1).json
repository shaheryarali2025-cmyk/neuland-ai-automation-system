    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\n\nconst messages = Array.isArray(source.items)\n  ? source.items\n  : [];\n\nif (messages.length === 0) {\n  throw new Error('Instantly thread contains no messages');\n}\n\n// Exact thread ID output ke andar se uthao\nconst targetThreadId = messages[0].thread_id;\n\n// Sirf same thread ke messages aur oldest → newest sorting\nconst sortedMessages = messages\n  .filter((message) => message.thread_id === targetThreadId)\n  .sort((a, b) => {\n    return (\n      new Date(a.timestamp_email).getTime() -\n      new Date(b.timestamp_email).getTime()\n    );\n  });\n\n// Lead ka received message\nconst receivedMessage =\n  sortedMessages.find((message) => message.ue_type === 2) ||\n  sortedMessages[0];\n\n// Original campaign email\nconst sentMessage =\n  sortedMessages.find((message) => message.ue_type === 1) ||\n  sortedMessages[0];\n\n// Latest received reply\nconst latestReceived =\n  [...sortedMessages]\n    .reverse()\n    .find((message) => message.ue_type === 2) ||\n  receivedMessage;\n\nreturn [\n  {\n    json: {\n      thread_id: targetThreadId,\n\n      lead_email:\n        receivedMessage.lead ||\n        receivedMessage.from_address_email ||\n        '',\n\n      full_name:\n        receivedMessage.from_address_json?.[0]?.name ||\n        '',\n\n      campaign_id:\n        receivedMessage.campaign_id ||\n        sentMessage.campaign_id ||\n        '',\n\n      sender_account:\n        sentMessage.from_address_email ||\n        sentMessage.eaccount ||\n        '',\n\n      subject:\n        latestReceived.subject ||\n        sentMessage.subject ||\n        '',\n\n      latest_reply:\n        latestReceived.content_preview ||\n        latestReceived.body?.text ||\n        '',\n\n      latest_reply_timestamp:\n        latestReceived.timestamp_email ||\n        '',\n\n      message_count: sortedMessages.length,\n\n      messages: sortedMessages,\n    },\n  },\n];"
      },
